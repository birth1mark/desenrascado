# ==============================================================================
# Desenrascado — Origin Protection (desenrascado.pt), Security & Cache Controls
# ==============================================================================

RewriteEngine On
RewriteBase /

# 1. Allow ACME verification
RewriteCond %{REQUEST_URI} ^/\.well-known/acme-challenge/ [NC]
RewriteRule .* - [L]

# 2. Allow legacy Android API calls directly without 301 (preserves POST payloads)
RewriteRule ^api/leaderboard\.php$ - [L]

# 3. Canonical 301 Redirects to https://desenrascado.pt/ for direct origin hits
# Skipped ONLY for requests coming from the Desenrascado Cloudflare Edge Proxy
RewriteCond %{HTTP_USER_AGENT} !^Desenrascado-Edge-Proxy [NC]
RewriteRule ^(?:index\.html)?$ https://desenrascado.pt/ [R=301,L,QSA]

RewriteCond %{HTTP_USER_AGENT} !^Desenrascado-Edge-Proxy [NC]
RewriteRule ^wiki(?:\.html)?/?$ https://desenrascado.pt/wiki [R=301,L,QSA]

RewriteCond %{HTTP_USER_AGENT} !^Desenrascado-Edge-Proxy [NC]
RewriteRule ^privacy(?:\.html)?/?$ https://desenrascado.pt/privacy [R=301,L,QSA]

RewriteCond %{HTTP_USER_AGENT} !^Desenrascado-Edge-Proxy [NC]
RewriteRule ^llm\.txt$ https://desenrascado.pt/llms.txt [R=301,L]

RewriteCond %{HTTP_USER_AGENT} !^Desenrascado-Edge-Proxy [NC]
RewriteRule ^(.*)$ https://desenrascado.pt/$1 [R=301,L,QSA]

# 4. Nice URLs for Cloudflare Edge Proxy (internal rewrites — zero redirect loops)
RewriteRule ^wiki/?$ wiki.html [L]
RewriteRule ^privacy/?$ privacy.html [L]

# 5. Security & Cache Headers
<IfModule mod_headers.c>
    Header merge Vary "User-Agent"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # HTML files: Never cache to guarantee instant game updates
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

Options -Indexes
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .md .html .css .js .json .xml
