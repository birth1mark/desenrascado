# ==============================================================================
# Desenrascado — Forced HTTPS & Hardened Security & Anti-Cache Controls
# ==============================================================================

RewriteEngine On
RewriteBase /

# 1. Allow ACME verification
RewriteCond %{REQUEST_URI} ^/\.well-known/acme-challenge/ [NC]
RewriteRule .* - [L]

# 2. Canonical HTTPS Redirection
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.desenrascado\.pormenores\.net$ [NC]
RewriteRule ^(.*)$ https://desenrascado.pormenores.net/$1 [L,R=301]

# 2b. Canonical 301 Redirects for legacy .html, trailing slashes & llm.txt alias
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://desenrascado.pormenores.net/ [R=301,L,QSA]

RewriteCond %{THE_REQUEST} \s/+wiki(?:\.html|/)[\s?] [NC]
RewriteRule ^wiki(?:\.html|/)$ https://desenrascado.pormenores.net/wiki [R=301,L,QSA]

RewriteCond %{THE_REQUEST} \s/+privacy(?:\.html|/)[\s?] [NC]
RewriteRule ^privacy(?:\.html|/)$ https://desenrascado.pormenores.net/privacy [R=301,L,QSA]

RewriteRule ^llm\.txt$ https://desenrascado.pormenores.net/llms.txt [R=301,L]

# 2c. Nice URLs (/wiki -> wiki.html, /privacy -> privacy.html)
RewriteRule ^wiki$ wiki.html [L]
RewriteRule ^privacy$ privacy.html [L]

# 3. Security Headers
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # HTML files: Never cache to guarantee instant game updates
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

Options -Indexes
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .md .html .css .js .json .xml
